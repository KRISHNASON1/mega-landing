# Files to ignore when uploading to Google Cloud Build
# This speeds up builds by excluding unnecessary files

# Dependencies (will be installed during build)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build outputs (will be rebuilt)
.next/
out/

# Development environment files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
README.md
SETUP_GUIDE.md
QUICK_START.md
LOGO_INSTRUCTIONS.md

# Agent and AI tooling
.claude/
.agents/

# Deployment scripts (not needed inside container)
deploy-to-cloudrun.sh
cloudbuild.yaml

# Server files (local dev only)
server.log
server.pid

# Skills
skills-lock.json
